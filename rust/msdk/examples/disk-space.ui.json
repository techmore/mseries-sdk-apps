{
  "sdk": 1,
  "app": { "id": "io.github.techmore.DiskSpace", "name": "Disk Space", "icon": "drive-harddisk" },
  "capabilities": ["filesystem:user-chosen", "trash"],
  "types": { "Entry": { "id": "text", "name": "text", "size": "text" } },
  "state": { "path": "text", "scanning": "bool", "progress": "number", "children": "list<Entry>", "has_result": "bool" },
  "logic": "rust",
  "messages": { "ChooseFolder": "none", "CancelScan": "none", "Drill": "text" },
  "surfaces": {
    "main": {
      "kind": "window",
      "title": "Disk Space",
      "header": [
        { "type": "Button", "label": "Choose folder", "icon": "folder-open", "on": "ChooseFolder", "button_style": "suggested" },
        { "type": "Button", "label": "Cancel scan", "on": "CancelScan", "visible_if": "scanning" }
      ],
      "body": {
        "type": "Box", "direction": "column", "spacing": "medium",
        "children": [
          { "type": "Text", "text": "{path}", "text_style": "heading" },
          { "type": "Progress", "label": "Scan progress", "bind": "progress", "visible_if": "scanning" },
          {
            "type": "Box", "direction": "row", "spacing": "large", "visible_if": "has_result",
            "children": [
              { "type": "Custom", "name": "Sunburst", "reason": "no circular treemap component in the vocabulary", "bind": "children" },
              {
                "type": "List", "items": "children", "key": "id", "on_select": "Drill",
                "row": { "type": "Card", "title": "{name}", "children": [{ "type": "Text", "text": "{size}", "text_style": "muted" }] },
                "empty": { "type": "EmptyState", "title": "This folder is empty" }
              }
            ]
          }
        ]
      }
    }
  }
}

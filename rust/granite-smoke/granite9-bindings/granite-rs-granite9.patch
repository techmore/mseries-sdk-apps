diff --git a/fix9.sh b/fix9.sh
new file mode 100755
index 0000000..8669871
--- /dev/null
+++ b/fix9.sh
@@ -0,0 +1,53 @@
+#!/bin/bash
+set -x -e
+
+# Remove Gee dependency, as we can't bind this yet
+xmlstarlet ed -L \
+	-d '///_:include[@name="Gee"]' \
+	Granite-9.0.gir
+
+# Remove functions with Gee return types
+xmlstarlet ed -L \
+	-d '///_:function/_:return-value/_:type[contains(@name, "Gee.")]/../..' \
+	Granite-9.0.gir
+
+# Rename c:identifier to c:type on constants
+xmlstarlet ed -L \
+	-r '///_:constant/@c:identifier' -v 'type' \
+	Granite-9.0.gir
+
+# Fix weirdly double namespaced stuff
+xmlstarlet ed -L \
+    -u '///_:type[starts-with(@name, "Granite.Granite")]/@name' \
+    -x 'substring-after(., "Granite.Granite")' \
+    Granite-9.0.gir
+
+xmlstarlet ed -L \
+    -u '///_:implements[starts-with(@name, "Granite.Granite")]/@name' \
+    -x 'substring-after(., "Granite.Granite")' \
+    Granite-9.0.gir
+
+# Add shared library to namespace
+xmlstarlet ed -L \
+    -u '///_:namespace/@shared-library' -v 'libgranite-9.so.9' \
+    -i '///_:namespace[not(@shared-library)]' -t attr -n 'shared-library' -v 'libgranite-9.so.9' \
+    Granite-9.0.gir
+
+# Remove const from constant string types
+xmlstarlet ed -L \
+    -u '///_:constant/_:type[@c:type="const gchar*"]/@c:type' -v 'gchar*' \
+    Granite-9.0.gir
+
+# Pass GdkRGBA by reference
+xmlstarlet ed -L \
+    -u '///_:type[@c:type="GdkRGBA"]/@c:type' -v 'GdkRGBA*' \
+    Granite-9.0.gir
+
+# Change instance-parameter to parameter on enum methods, gir gets confused by an instance-parameter on a non-class function
+xmlstarlet ed -L \
+    -r '///_:function[@name="box_spacing_to_string"]/_:parameters/_:instance-parameter' -v 'parameter' \
+    Granite-9.0.gir
+
+xmlstarlet ed -L \
+    -r '///_:function[@name="header_label_size_to_string"]/_:parameters/_:instance-parameter' -v 'parameter' \
+    Granite-9.0.gir
\ No newline at end of file

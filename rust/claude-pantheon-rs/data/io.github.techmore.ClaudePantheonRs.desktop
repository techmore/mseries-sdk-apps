[Desktop Entry]
Name=T3
GenericName=AI coding agents
Comment=Threads with Claude, Codex, OpenCode and Grok on your T3 Code server, grouped by repo and issue, with plan usage
Exec=claude-pantheon-rs
Icon=io.github.techmore.ClaudePantheonRs
Terminal=false
Type=Application
Categories=Development;GTK;
Keywords=Claude;Codex;AI;agent;chat;T3;usage;tokens;GitHub;issues;
StartupNotify=true
DBusActivatable=true
X-GNOME-UsesNotifications=true
Actions=new-thread;usage;repositories;activity;
X-MSeries-Chat=true

[Desktop Action new-thread]
Name=New Thread
Exec=claude-pantheon-rs --new-thread

[Desktop Action usage]
Name=Usage
Exec=claude-pantheon-rs --usage

[Desktop Action repositories]
Name=Repositories
Exec=claude-pantheon-rs --repositories

[Desktop Action activity]
Name=Activity
Exec=claude-pantheon-rs --activity

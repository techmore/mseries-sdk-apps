#!/usr/bin/env python3
"""Native T3 adapter: explicit connector configuration and read-only fleet refresh."""
import importlib.machinery
import importlib.util
import json
import fcntl
import os
from pathlib import Path
import secrets
import stat
import sys

local = Path(__file__).resolve().with_name('fleet-snapshot')
installed = Path(__file__).resolve().parents[1] / 'lib/mseries/fleet/fleet-snapshot'
source = local if local.parent.parent.name == 'fleet-shepherd' else installed
spec = importlib.util.spec_from_loader('fleet_snapshot', importlib.machinery.SourceFileLoader('fleet_snapshot', str(source)))
fs = importlib.util.module_from_spec(spec)
spec.loader.exec_module(fs)


def config_path():
    return Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'fleet-shepherd/connectors.json'


def save(path, connectors):
    # A private, owned, non-symlink directory and atomic same-directory replacement.
    parent = path.parent
    parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = parent.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
        raise ValueError('Connector directory must be an owned directory, not a link')
    fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    os.fchmod(fd, 0o700)
    temporary = '.connectors-' + secrets.token_hex(16)
    try:
        try:
            current = os.stat(path.name, dir_fd=fd, follow_symlinks=False)
            if not stat.S_ISREG(current.st_mode) or current.st_uid != os.geteuid():
                raise ValueError('Connector file must be an owned regular file')
        except FileNotFoundError:
            pass
        data = json.dumps({'schemaVersion': 1, 'connectors': connectors}, indent=2).encode() + b'\n'
        with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=fd), 'wb') as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path.name, src_dir_fd=fd, dst_dir_fd=fd)
        os.fsync(fd)
    finally:
        try:
            os.unlink(temporary, dir_fd=fd)
        except FileNotFoundError:
            pass
        os.close(fd)


def main():
    path = config_path()
    action = sys.argv[1] if len(sys.argv) > 1 else 'list'
    if action == 'snapshot' and len(sys.argv) == 2:
        # No cache or stale fallback: identity always comes from this configuration.
        os.execv(sys.executable, [sys.executable, str(source), '--connectors', str(path)])
    connectors = fs.load_connectors(str(path))
    if action == 'add' and len(sys.argv) == 4:
        label, target = sys.argv[2:]
        item = {'id': fs.validate_id(target, 'SSH alias'), 'label': label, 'mode': 'ssh', 'target': target}
        connectors = fs.parse_connectors(json.dumps({'schemaVersion': 1, 'connectors': connectors + [item]}).encode())
        save(path, connectors)
    elif action == 'remove' and len(sys.argv) == 3:
        target = fs.validate_id(sys.argv[2], 'connector id')
        if not any(c['id'] == target and c['mode'] == 'ssh' for c in connectors):
            raise ValueError('Connector no longer exists')
        connectors = [c for c in connectors if c['id'] != target]
        # Upstream requires a nonempty connector list; keep its explicit local row.
        if not connectors:
            raise ValueError('Keep at least one connector')
        save(path, connectors)
    elif action != 'list' or len(sys.argv) > 2:
        raise ValueError('Use list, add LABEL SSH_ALIAS, remove ID, or snapshot')
    print(json.dumps({'schemaVersion': 1, 'connectors': connectors}))


if __name__ == '__main__':
    lock = None
    try:
        if len(sys.argv) > 1 and sys.argv[1] in ('add', 'remove'):
            parent = config_path().parent
            parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                lock = os.open('.connectors.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600, dir_fd=directory)
                info = os.fstat(lock)
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
                    raise ValueError('Invalid connector lock')
                os.fchmod(lock, 0o600)
                fcntl.flock(lock, fcntl.LOCK_EX)
            finally:
                os.close(directory)
        main()
    except (OSError, ValueError, fs.ConfigError) as error:
        print(json.dumps({'error': str(error)[:256]}))
        sys.exit(2)
